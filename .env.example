# Wiggly's Minecraft AI Villagers - (c) 2026 WiggleCodes. Copy this file to .env and fill it in.

# --- The villagers' brains ---
# Without a key, every villager starts in manual mode (MCP/API control only).
# Any OpenAI-compatible service works. These settings are for NVIDIA build.nvidia.com (free, rate-limited):
OPENAI_API_KEY=
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL=minimaxai/minimax-m3.1-flash
# Per key/service; it scales with the pool below
MAX_LLM_CALLS_PER_MINUTE=4
# More capacity: comma-separate several keys in OPENAI_API_KEY, and/or add other OpenAI-compatible
# services, each as EXTRA_AI_n=baseURL|apiKey|model. The villagers take turns across all of them.
#   EXTRA_AI_1=https://openrouter.ai/api/v1|sk-or-...|some-provider/some-model:free
#
# Free AI services with built-in settings (src/agent/providers.js): paste a key and that service joins in.
# Each is tested at start-up (bad keys are skipped, retired models swapped for a current one) and paced by
# its own free limit, so every service you add means more thinking for the villagers. Several keys for one
# service: comma-separate them. Override a model with <SERVICE>_MODEL, e.g. GROQ_MODEL=...
#   GROQ_API_KEY=gsk_...                 https://console.groq.com/keys
#   GEMINI_API_KEY=AIza...               https://aistudio.google.com/apikey
#   OPENROUTER_API_KEY=sk-or-...         https://openrouter.ai/settings/keys (uses its :free models)
#   MISTRAL_API_KEY=...                  https://console.mistral.ai/api-keys
#   CLOUDFLARE_API_TOKEN=...             https://dash.cloudflare.com/profile/api-tokens (Workers AI)
#   CLOUDFLARE_ACCOUNT_ID=...            (on your Cloudflare dashboard)
#   CEREBRAS_API_KEY=csk-...             https://cloud.cerebras.ai
#   COHERE_API_KEY=...                   https://dashboard.cohere.com/api-keys (small trial allowance)

# --- Minecraft server (overrides config/bots.json) ---
MC_HOST=127.0.0.1
MC_PORT=25565
# Leave empty to auto-detect the server version
MC_VERSION=

# Your Minecraft username(s), comma separated. Only these players can give "@Name ..." orders in chat.
# Empty = anyone on the server can give orders.
OWNERS=

# --- Pacing & cost control ---
# Seconds between each villager's "thoughts" when nothing is happening
TICK_SECONDS=45
# Max model calls per thought (each call can run several actions)
MAX_STEPS_PER_TICK=6
# Max model calls running at once across all villagers
MAX_CONCURRENT_LLM=3
# Hard cap on model calls per rolling hour across all villagers (0 = no cap)
MAX_LLM_CALLS_PER_HOUR=600
# Habits: routines that worked are saved to data/habits.json and replayed without the AI (saves credits).
# The AI still gets every (HABIT_REPEATS+1)th turn, and anything new (chat, danger, jobs). 0 = always use the AI.
HABIT_REPEATS=3
# How long a villager's brain pauses after you control it directly with an mc_* tool
MANUAL_HOLD_SECONDS=120
# autonomous | directed | manual
DEFAULT_MODE=autonomous
# Use fewer villagers than config/bots.json defines (handy for testing)
MAX_BOTS=
# Gap between villagers joining (server connection throttle is 4s by default)
JOIN_DELAY_MS=5000

# --- Local control API and brain dashboard (also used by the MCP server) ---
# 127.0.0.1 = this PC only. 0.0.0.0 = reachable from your Wi-Fi (set an API_TOKEN if you do).
API_HOST=127.0.0.1
API_PORT=3005
# Shared secret. Needed by the MCP server's env and the dashboard link (?token=...) when set.
API_TOKEN=
